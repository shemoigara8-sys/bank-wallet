# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DATABASE_URL=sqlite:///kwallet.db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Default Admin Credentials (change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# M-Pesa Daraja API Credentials
# Get these from: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here

# M-Pesa Environment (sandbox or production)
MPESA_ENVIRONMENT=sandbox

# Callback URL (for M-Pesa to send payment confirmations)
# This should be your public URL in production
MPESA_CALLBACK_URL=http://localhost:5000/api/mpesa/callback
